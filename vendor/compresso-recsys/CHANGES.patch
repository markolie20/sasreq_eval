+def test_the_score_is_logits_over_the_whole_vocabulary():
+    model = _model()
+    with torch.no_grad():
+        scores = model.score(model(_tokens([2, 3, 4]))[:, -1])
+    assert scores.shape == (1, N_RESERVED + N_ITEMS)
+    assert not torch.allclose(scores.exp().sum(dim=-1), torch.ones(1))
