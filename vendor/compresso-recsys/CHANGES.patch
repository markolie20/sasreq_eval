+# --------------------------------------------------------------------------
+# persistence
+# --------------------------------------------------------------------------
+
+
+def test_a_reloaded_model_predicts_identically(tmp_path):
+    trainer = _fitted_on_cycle(epochs=2)
+    source = _seqs([[0, 1, 2], [3, 4, 5]])
