+def _one_step(trainer, x, sources, candidates, chunk):
+    """The loss and every gradient of one training step, with nothing updated."""
+    trainer.cfg = replace(trainer.cfg, loss_chunk_elements=chunk)
+    trainer.optimizer = torch.optim.SGD(trainer.elsa.parameters(), lr=0.0)
+    result = trainer.train_step(x, sources, candidates)
+    return result, [parameter.grad.clone() for parameter in trainer.elsa.parameters()]
