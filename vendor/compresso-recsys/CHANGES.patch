+def test_a_position_reads_the_items_before_it():
+    model = _model()
+    with torch.no_grad():
+        first = model(_tokens([2, 3, 4, 5]))
+        second = model(_tokens([9, 3, 4, 5]))
+    assert not torch.allclose(first[:, -1], second[:, -1])
