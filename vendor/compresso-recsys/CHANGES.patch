+def test_recommend_round_trips_real_item_ids():
+    item_ids = [f"item-{index}" for index in range(N_ITEMS)]
+    batcher = SequenceBatcher(_tokenizer(item_ids=item_ids), max_length=6)
+    trainer = LRURecTrainer(
