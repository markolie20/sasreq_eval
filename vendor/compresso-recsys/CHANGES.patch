+@pytest.mark.parametrize("with_candidates", [False, True])
+def test_a_chunked_loss_is_the_same_loss_and_gradient(interactions, with_candidates):
+    trainer = _trainer(max_output=None).fit(interactions)
+    dense = torch.tensor(interactions.toarray())
+    if with_candidates:
+        sources, candidates = torch.arange(6), torch.tensor([0, 1, 2, 3, 4, 5, 7])
+        x = dense[:, :6]
+    else:
+        sources, candidates, x = torch.arange(8), None, dense
+    whole, whole_grads = _one_step(trainer, x, sources, candidates, 2**27)
+    for chunk in (1, 16):  # one user per group; two users per group
+        result, grads = _one_step(trainer, x, sources, candidates, chunk)
+        for key in ("loss", "cosine_loss"):
+            assert float(result[key]) == pytest.approx(float(whole[key]), rel=1e-6)
+        for a, b in zip(whole_grads, grads):
+            assert torch.allclose(a, b, rtol=1e-5, atol=1e-7)
+
+
+def test_loss_chunk_elements_must_be_positive():
