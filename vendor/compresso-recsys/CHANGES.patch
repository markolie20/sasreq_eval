+    trainer = Bert4RecTrainer(_config(max_history_length=6), batcher)
+    with pytest.raises(ValueError, match="must match the batcher tokenizer"):
+        trainer.fit(_seqs(_cycle_rows()), item_ids=[f"x{i}" for i in range(N_ITEMS)])
