+                "max_length": int(self.batcher.max_length),
+                "history": self.history,
+            },
+        )
+        writer.write_json(
+            "state/tokenizer.json",
+            self.batcher.tokenizer.to_dict(include_item_ids=False),
+        )
+        item_ids = self.batcher.tokenizer.item_ids
